{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Vite Launch (Frontend)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/web/node_modules/vite/bin/vite.js",
            "args": ["dev"],
            "cwd": "${workspaceFolder}/web",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Debug .NET Core (API)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/leaguerAPI/bin/Debug/net9.0/leaguerAPI.dll",
            "args": [],
            "cwd": "${workspaceFolder}/leaguerAPI",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ],
    "compounds": [
        {
            "name": "Launch API and Frontend",
            "configurations": ["Debug .NET Core (API)", "Vite Launch (Frontend)"]
        }
    ]
}